# demo = sample parser and simulated payments; sandbox = Gemini and PayPal Sandbox
VOICETAB_MODE=demo
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:3000

# Required in sandbox mode: stall key and PayPal credentials.
# Gemini is optional for typed and supported browser-speech orders.
STALL_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

